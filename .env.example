# Neon: pooled URL for the app, direct URL for migrations
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app (callback: https://<host>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub user id of the only allowed account: https://api.github.com/users/<login>
AUTH_OWNER_GITHUB_ID=
